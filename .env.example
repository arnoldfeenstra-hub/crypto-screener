# Copy to .env and fill in. .env is gitignored (hard rule 5).

# Bitquery v2 (Solana EAP endpoint). https://account.bitquery.io/user/api_v2/access_tokens
BITQUERY_TOKEN=
BITQUERY_ENDPOINT=https://streaming.bitquery.io/eap

# Where the append-only dataset lives. Outside the repo tree is fine.
SCREENER_DB_PATH=data/screener.duckdb
SCREENER_PARQUET_DIR=data/parquet

# Polling cadence for the trigger watcher, in seconds.
WATCHER_POLL_SECONDS=60

# Phase 0 items 3-5 (social + outcomes) are not implemented yet. These are
# listed so the shape is known, not because anything reads them.
# X_BEARER_TOKEN=
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# LUNARCRUSH_API_KEY=

# X (Twitter) API v2 recent search -- collectors/social_x.py. The only metered
# source in this repo: every other one is keyless and free. Setting the token
# switches the X collector on inside `python -m collect`; leaving it unset keeps
# it off and the cycle summary says so rather than going quiet.
# See docs/x-investigation.md for what it buys and what it costs.
X_BEARER_TOKEN=
# Hard cap on the API calls one cycle may make. Recent search is billed per post
# read (up to 100 a search), the cycle runs hourly, and an unbudgeted first run
# over a backlog of snapshots can spend a month of quota before anyone reads the
# log. 40 covers a day of new snapshots at the t+0 offset.
X_MAX_SEARCHES_PER_CYCLE=40

# Token addresses to poll regardless of whether anyone boosted or profiled them,
# comma separated. DexScreener discovery only returns tokens somebody paid to
# boost or filled in a profile for, so a live chain can produce an empty poll
# forever -- binding its chainId is necessary and not sufficient. A seed is an
# operator saying "this token exists, look at it". It does not bypass the
# trigger: a seeded token enters the dataset only if it crosses, like every
# other token, and its row records entry_path="seed" so the selection effect is
# in the data rather than in somebody's memory.
#   python -m collectors.dexscreener --resolve-token <address>   # which chain?
SCREENER_SEED_TOKENS=
