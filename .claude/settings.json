{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)",
      "Bash(curl:* -X POST*)",
      "Bash(curl:* -X PUT*)",
      "Bash(curl:* -X DELETE*)",
      "Bash(curl:* --request POST*)",
      "Bash(curl:* -d *)",
      "Bash(wget:* --post-data*)",
      "Bash(wget:* --post-file*)",
      "WebFetch"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(git push:*)"
    ]
  }
}
